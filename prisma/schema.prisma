// We Lodge OS — Phase 1 (Scouting).
//
// This schema implements §3 of docs/product-scope.md. It deliberately stops at
// the scouting list: no room slots, no room-nights, no acquisition or sales
// state. Those arrive with Phase 2 and must be added alongside the document,
// not ahead of it.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  PLANNING
  ACTIVE
  CLOSED
}

enum PropertyType {
  HOTEL
  APARTMENT
}

/// Where a property has got to in *this* event's scouting list. The same
/// property can be shortlisted for one event and rejected for another, which is
/// why this lives on the entry rather than on the property (doc §3.5).
enum ScoutingStatus {
  PROSPECT
  CONTACTED
  SHORTLISTED
  REJECTED
  CONTRACTED
}

/// An event we are providing accommodation for. The container everything else
/// hangs off (doc §2.3).
model Event {
  id        String      @id @default(cuid())
  name      String
  city      String?
  country   String?
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  status    EventStatus @default(PLANNING)

  /// The venue guests need to be near. Distance-to-venue is derived from this
  /// and the property's own coordinates.
  venueName      String?
  venueLatitude  Float?
  venueLongitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scoutingEntries ScoutingEntry[]

  @@index([startDate])
}

/// A hotel or apartment building we could contract. Scouted once, reusable
/// across events — an event-specific view of it is a ScoutingEntry.
model Property {
  id      String       @id @default(cuid())
  name    String
  type    PropertyType
  address String?
  city    String?
  country String?

  /// Optional. Present ⇒ the property appears on the map view.
  latitude  Float?
  longitude Float?

  /// Hotels only, and only when we know it.
  stars Int?

  /// Stated total, for properties whose categories are not broken out yet. The
  /// UI prefers the sum of the categories when there are any.
  totalRooms Int?

  website String?
  phone   String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories      RoomCategory[]
  contacts        PropertyContact[]
  amenities       Amenity[]         @relation("PropertyAmenities")
  scoutingEntries ScoutingEntry[]

  scoutedBy   User?   @relation(fields: [scoutedById], references: [id], onDelete: SetNull)
  scoutedById String?

  @@index([name])
  @@index([city])
}

/// A room type at a hotel, or a unit type in an apartment building. Both are
/// "a countable, sellable, occupiable thing" — the distinction is which fields
/// are filled in (doc §3.2, §3.3).
model RoomCategory {
  id   String @id @default(cuid())
  name String

  /// How many rooms/units of this type the property has in total.
  unitCount Int @default(0)

  /// Standard occupancy, in people.
  capacity Int @default(2)

  /// Hotels: "1 King", "2 Twin". Drives the Phase 3 occupancy checks.
  bedConfiguration String?

  /// Apartments: halves are allowed for bathrooms (1.5).
  bedrooms  Int?
  bathrooms Float?

  /// Indicative nightly price at scouting time — not a contracted rate.
  indicativePriceCents Int?
  currency             String @default("CHF")

  sortOrder Int @default(0)

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  @@index([propertyId])
}

/// A controlled vocabulary, shared by both property types, so amenities stay a
/// filter rather than a tag soup (doc §3.4).
model Amenity {
  id        String @id @default(cuid())
  key       String @unique
  label     String
  sortOrder Int    @default(0)

  properties Property[] @relation("PropertyAmenities")

  @@index([sortOrder])
}

/// Someone at the property we talk to.
model PropertyContact {
  id    String  @id @default(cuid())
  name  String
  role  String?
  email String?
  phone String?

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  @@index([propertyId])
}

/// A property on one event's scouting list. Nothing here implies a commercial
/// position — that starts in Phase 2.
model ScoutingEntry {
  id     String         @id @default(cuid())
  status ScoutingStatus @default(PROSPECT)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  addedBy   User?   @relation(fields: [addedById], references: [id], onDelete: SetNull)
  addedById String?

  @@unique([eventId, propertyId])
  @@index([eventId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// NextAuth
// ---------------------------------------------------------------------------

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  scoutedProperties Property[]
  scoutingEntries   ScoutingEntry[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
