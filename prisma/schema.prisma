// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  INQUIRY
  OPTIONED
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum EventStatus {
  PLANNING
  ACTIVE
  CLOSED
}

/// A sports federation, media outlet, sponsor or event team we house.
model Client {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]

  @@index([name])
}

/// An event we are providing accommodation for (e.g. a championship).
model Event {
  id        String      @id @default(cuid())
  name      String
  city      String?
  country   String?
  startDate DateTime
  endDate   DateTime
  status    EventStatus @default(PLANNING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  properties Property[]
  bookings   Booking[]

  @@index([startDate])
}

/// A hotel or apartment block in our inventory for an event.
model Property {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  country   String?
  stars     Int?
  roomCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?

  rooms    Room[]
  bookings Booking[]

  @@index([name])
  @@index([eventId])
}

/// A room category held at a property, with its nightly rate and allotment.
model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int      @default(2)
  /// Nightly rate in minor units (e.g. cents) to avoid float drift.
  rateCents Int      @default(0)
  currency  String   @default("CHF")
  allotment Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  bookings Booking[]

  @@index([propertyId])
}

/// A guest we are accommodating.
model Guest {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([lastName])
}

/// The core record: a guest in a room for a date range.
model Booking {
  id        String        @id @default(cuid())
  reference String        @unique
  status    BookingStatus @default(INQUIRY)
  checkIn   DateTime
  checkOut  DateTime
  guests    Int           @default(1)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  guest   Guest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestId String?

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId String?

  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId String?

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@index([status])
  @@index([checkIn])
  @@index([eventId])
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
