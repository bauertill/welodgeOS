// We Lodge OS — Phases 1 and 2.
//
// This schema implements §3 (Scouting) and §4 (Acquisition & Sales) of
// docs/product-scope.md. It deliberately stops before Phase 3: no parties, no
// guests, no assignments. Those arrive with §6 and must be added alongside the
// document, not ahead of it.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  PLANNING
  ACTIVE
  CLOSED
}

enum PropertyType {
  HOTEL
  APARTMENT
  /// Self-contained apartment-style units — bedrooms and bathrooms, like an
  /// apartment — but still star-rated and run like a hotel (doc §3.3).
  APARTHOTEL
}

/// Where a property has got to in *this* event's scouting list. The same
/// property can be shortlisted for one event and rejected for another, which is
/// why this lives on the entry rather than on the property (doc §3.5).
///
/// `CONTRACTED` is kept only so the enum stays valid for any historical row —
/// it is no longer settable from the UI. A property has no single contract
/// status of its own; that fact now lives per room category, on
/// `CategoryContract` (doc §3.5).
enum ScoutingStatus {
  PROSPECT
  CONTACTED
  SHORTLISTED
  REJECTED
  CONTRACTED
}

/// How far along one room category's supplier contract is, for one event. A
/// property is rarely all-or-nothing: one category can be signed while another
/// is still being drafted (doc §3.5, §3.6).
enum CategoryContractStatus {
  IN_NEGOTIATION
  IN_CONTRACTING
  CONTRACTED
}

/// An event we are providing accommodation for. The container everything else
/// hangs off (doc §2.3).
model Event {
  id        String      @id @default(cuid())
  name      String
  city      String?
  country   String?
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  status    EventStatus @default(PLANNING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Venues, airports, stations and the rest (doc §3.7). This replaced the
  /// single venue an event used to carry: a Games has several.
  placesOfInterest PlaceOfInterest[]

  scoutingEntries ScoutingEntry[]
  roomNights      RoomNight[]
  ledger          LedgerEntry[]
  propertyGroups  PropertyGroup[]
  salesRequests   SalesRequest[]
  contracts       Contract[]

  @@index([startDate])
}

/// What kind of place guests need to reach (doc §3.7). The category drives
/// how the pin is drawn and how the list is grouped, nothing else.
enum PlaceCategory {
  VENUE
  TRAIN_STATION
  AIRPORT
  OTHER
}

/// Somewhere guests need to get to for one event: a stadium, an airport, a
/// station, the IBC (doc §3.7). Unlike a property, a place of interest belongs
/// to a single event — the same airport used by two events is entered twice.
model PlaceOfInterest {
  id       String        @id @default(cuid())
  name     String
  category PlaceCategory

  /// Train stations: the lines serving it, as the business writes them
  /// ("RER A, RER D, M1, M14"). Free text — this is read, never computed on.
  lines String?

  address String?

  /// Required, unlike a property's: a place nobody can locate is of no use,
  /// since its whole purpose is to be measured from.
  latitude  Float
  longitude Float

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  /// One name per event — two "Gare de Lyon" pins on one map is a mistake,
  /// not a distinction.
  @@unique([eventId, name])
  @@index([eventId, category])
}

/// A hotel or apartment building we could contract. Scouted once, reusable
/// across events — an event-specific view of it is a ScoutingEntry.
model Property {
  id      String       @id @default(cuid())
  name    String
  type    PropertyType
  address String?
  city    String?
  country String?

  /// Optional. Present ⇒ the property appears on the map view.
  latitude  Float?
  longitude Float?

  /// Hotels only, and only when we know it.
  stars Int?

  /// Stated total, for properties whose categories are not broken out yet. The
  /// UI prefers the sum of the categories when there are any.
  totalRooms Int?

  website String?
  phone   String?
  notes   String?

  // The rest of what the team records about a property (doc §3.9) — the same
  // on every event.
  /// The neighbourhood, e.g. "Santa Monica". City stays separate.
  area           String?
  yearBuilt      Int?
  generalEmail   String?
  videoUrl       String?
  /// The property's standard times, as written, e.g. "15:00".
  checkInTime    String?
  checkOutTime   String?
  /// Free text, so "Included", "USD 25 pp" or "No" all fit.
  breakfast      String?
  cleaning       String?
  laundry        String?
  gym            String?
  publicTransport String?

  // Contracting details (doc §3.9): the legal entity a contract is signed
  // with. Visible to every colleague — accepted by the business for now.
  tradeName          String?
  vatNumber          String?
  registrationNumber String?
  iban               String?
  bic                String?
  signatoryName      String?
  signatoryTitle     String?
  /// Where a contract is sent for signature.
  contractEmail      String?

  /// The chain or group it belongs to, if any.
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories      RoomCategory[]
  contacts        PropertyContact[]
  amenities       Amenity[]         @relation("PropertyAmenities")
  scoutingEntries ScoutingEntry[]
  updates         Update[]
  contracts       Contract[]

  scoutedBy   User?   @relation(fields: [scoutedById], references: [id], onDelete: SetNull)
  scoutedById String?

  @@index([name])
  @@index([city])
}

/// A room type at a hotel, or a unit type in an apartment building. Both are
/// "a countable, sellable, occupiable thing" — the distinction is which fields
/// are filled in (doc §3.2, §3.3).
model RoomCategory {
  id   String @id @default(cuid())
  name String

  /// How many rooms/units of this type the property has in total.
  unitCount Int @default(0)

  /// Standard occupancy, in people.
  capacity Int @default(2)

  /// Hotels: "1 King", "2 Twin". Drives the Phase 3 occupancy checks.
  bedConfiguration String?

  /// Apartments: halves are allowed for bathrooms (1.5).
  bedrooms  Int?
  bathrooms Float?

  /// Indicative nightly price range at scouting time — not a contracted rate.
  /// A range, not a point figure: what a rep sees on Booking.com-style
  /// listings before a real rate is negotiated (doc §3.2, §3.3).
  indicativePriceMinCents Int?
  indicativePriceMaxCents Int?
  currency                String @default("CHF")

  sortOrder Int @default(0)

  /// The room's size, as written, e.g. "28 m²" (doc §3.9).
  size  String?
  notes String?

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  /// Phase 2 room slots numbered 1..N within this category (doc §2.1).
  slots RoomSlot[]

  /// This category's own supplier-contract status, per event (doc §3.5, §3.6).
  categoryContracts CategoryContract[]

  @@index([propertyId])

  quotationLines QuotationLine[]
}

/// A controlled vocabulary, shared by both property types, so amenities stay a
/// filter rather than a tag soup (doc §3.4).
model Amenity {
  id        String @id @default(cuid())
  key       String @unique
  label     String
  sortOrder Int    @default(0)

  properties Property[] @relation("PropertyAmenities")

  @@index([sortOrder])
}

/// Someone at the property we talk to.
/**
 * A provider (doc §3.9): the hotel chain or group a property belongs to. One
 * provider has many properties. It can carry its own contacts and contracting
 * details for the rare chain that signs one contract for several hotels; a
 * property with none of its own falls back on these.
 */
model Provider {
  id    String  @id @default(cuid())
  name  String  @unique
  website String?
  notes String?

  // Contracting details (doc §3.9): the legal entity a contract is signed
  // with. Visible to every colleague — accepted by the business for now.
  tradeName          String?
  vatNumber          String?
  registrationNumber String?
  iban               String?
  bic                String?
  signatoryName      String?
  signatoryTitle     String?
  /// Where a contract is sent for signature.
  contractEmail      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
  contacts   ProviderContact[]
}

model ProviderContact {
  id    String  @id @default(cuid())
  name  String
  role  String?
  email String?
  phone String?

  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String

  @@index([providerId])
}

model PropertyContact {
  id    String  @id @default(cuid())
  name  String
  role  String?
  email String?
  phone String?

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  @@index([propertyId])
}

/// A property on one event's scouting list. Nothing here implies a commercial
/// position — that starts in Phase 2.
model ScoutingEntry {
  id     String         @id @default(cuid())
  status ScoutingStatus @default(PROSPECT)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  addedBy   User?   @relation("AddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedById String?

  /// The per-category contract status underneath this entry (doc §3.5, §3.6).
  categoryContracts CategoryContract[]
  /// The hotel's quotations for this event — several scenarios at once (doc §3.10).
  quotations Quotation[]

  /// The group the team has sorted this property into on this event (doc
  /// §3.9). Empty means "No group". Deleting a group leaves its entries here.
  group   PropertyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId String?

  // Agreed for this event (doc §3.9) — never shared with another event's entry.
  /// The rep who owns this hotel on this event.
  accountManager   User?   @relation("AccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  accountManagerId String?
  /// Contracting text, in the words that go to the lawyers.
  applicablePeriod  String?
  ratesInclude      String?
  deposit           String?
  cancellationTerms String?
  paymentTerms      String?
  /// When the hotel's hold on our rooms runs out — not a client's block (§4.2).
  blockExpiry         DateTime? @db.Date
  roomingListDeadline DateTime? @db.Date
  minimumStayNights   Int?

  @@unique([eventId, propertyId])
  @@index([eventId])
  @@index([status])
}

/// One room category's supplier-contract status on one event's scouting list.
/// Absent means `IN_NEGOTIATION` — a row only exists once someone has said
/// otherwise, so adding a property to a list never has to pre-create one of
/// these per category (doc §3.5, §3.6).
/** The colours a property group can have — a fixed palette, each legible on the page. */
enum GroupColour {
  PURPLE
  BLUE
  TEAL
  GREEN
  LIME
  YELLOW
  ORANGE
  RED
  PINK
  GREY
}

/**
 * A group on an event's Properties tab (doc §3.9): how the team chooses to
 * sort its work — "Proposal received", "Apartments" — independent of status.
 * Each event has its own.
 */
model PropertyGroup {
  id        String      @id @default(cuid())
  name      String
  colour    GroupColour @default(PURPLE)
  /// Order on the page, top first.
  position  Int         @default(0)
  createdAt DateTime    @default(now())

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  entries ScoutingEntry[]

  @@index([eventId])
}

/// What a room category's rate can include (doc §3.9).
enum RateInclusion {
  BREAKFAST
  WIFI
  TAXES
  PARKING
}

/// How often a room is cleaned when the rate includes cleaning (doc §3.9).
enum Cleaning {
  DAILY
  WEEKLY
  OTHER
}

model CategoryContract {
  id     String                 @id @default(cuid())
  status CategoryContractStatus @default(IN_NEGOTIATION)

  // The rates and taxes agreed for this room category on this event (doc
  // §3.9) — an LA28 rate never overwrites an EXPO 2030 one.
  /// Minor units, with an explicit currency (§4.5): never a float.
  ratePerNightCents Int?
  rateCurrency      String?
  /// What the rate includes, from a fixed list, plus anything else in words.
  rateIncludes      RateInclusion[] @default([])
  rateIncludesOther String?
  /// Set when the rate includes cleaning, saying how often; OTHER is said in
  /// cleaningOther. Empty means cleaning is not included.
  cleaning          Cleaning?
  cleaningOther     String?
  /// TOT as hundredths of a percent: 15.00% is 1500.
  totBasisPoints    Int?
  otherTaxes        String?
  applicablePeriod  String?

  scoutingEntry   ScoutingEntry @relation(fields: [scoutingEntryId], references: [id], onDelete: Cascade)
  scoutingEntryId String

  category   RoomCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  updatedAt DateTime @updatedAt

  @@unique([scoutingEntryId, categoryId])
  @@index([scoutingEntryId])
}

// --- Quotations (doc §3.10) ------------------------------------------------------

/// Where a quotation stands with us.
enum QuotationStatus {
  RECEIVED
  ACCEPTED
  DECLINED
}

/**
 * One quotation from a hotel for an event — one scenario among several (doc
 * §3.10): a group, periods and room categories with their rooms and rates, and
 * the terms offered. It is what the hotel offered, kept apart from what the
 * hotel is (its general details); an accepted one becomes the supplier contract.
 */
model Quotation {
  id     String          @id @default(cuid())
  status QuotationStatus @default(RECEIVED)
  /// "Austria House staff", "Plan B — 20 rooms".
  name   String

  scoutingEntry   ScoutingEntry @relation(fields: [scoutingEntryId], references: [id], onDelete: Cascade)
  scoutingEntryId String

  receivedOn DateTime? @db.Date
  /// Until when the hotel holds the offer.
  validUntil DateTime? @db.Date
  /// How many rooms the quotation is for, as the hotel put it.
  rooms      Int?
  /// Every line's rate is in this currency (§4.5).
  currency   String
  /// The terms offered, in the hotel's words — they become a contract's
  /// structured payments and cut-offs once accepted (§7.1).
  paymentTerms      String?
  cancellationTerms String?
  /// What the rates include and the taxes on them, as on a room category's
  /// rate for an event (§3.9).
  rateIncludes      RateInclusion[] @default([])
  rateIncludesOther String?
  cleaning          Cleaning?
  cleaningOther     String?
  /// TOT as hundredths of a percent: 15.00% is 1500.
  totBasisPoints    Int?
  otherTaxes        String?
  /// The quotation as received — a Google Drive link.
  documentUrl String?
  notes       String?

  /// The supplier contract made from it, once accepted.
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  contractId String?

  lines QuotationLine[]

  addedBy   User?    @relation("QuotationAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scoutingEntryId])
}

/// One line of a quotation: rooms of one category, for one period, at one rate.
model QuotationLine {
  id          String    @id @default(cuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String

  category   RoomCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  /// The period, as a stay: first night to check-out day.
  checkIn    DateTime @db.Date
  checkOut   DateTime @db.Date
  rooms      Int
  /// Minor units, in the quotation's currency.
  rateCents  Int
  /// People per room, where the quote says.
  occupancy  Int?
  position   Int      @default(0)

  @@index([quotationId])
}

// --- Contracts, payments and cancellation deadlines (doc §7.1) ---------------

/// Who a contract is with: a hotel or provider we buy from, or a client we sell to.
enum ContractParty {
  SUPPLIER
  CLIENT
}

/// Where a payment stands. Suppliers invoice us; we invoice clients.
enum PaymentStatus {
  TO_BE_PAID
  INVOICE_REQUESTED
  INVOICE_RECEIVED
  INVOICE_ISSUED
  PAID
  REFUND
}

/// What a cancellation deadline lets us — or the client — do by its cut-off.
enum CancellationKind {
  /// We may reduce the rooms or nights by an agreed share, without paying for them.
  ATTRITION
  /// We may hand rooms back, or an exclusivity lapses.
  RELEASE
  /// The client may cancel, free or for a fee.
  CLIENT_CANCELLATION
  OTHER
}

/**
 * A signed contract — with a supplier or with a client — for one event (doc
 * §7.1): the PDF, the total it is worth, and its payment and cancellation
 * terms. Room-nights are bought and sold under one.
 */
model Contract {
  id    String        @id @default(cuid())
  party ContractParty
  /// "Group Sales Agreement — Courtyard Culver City"
  name  String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventId String
  /// The hotel, on a supplier contract.
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  propertyId String?
  /// The client, on a client contract — and, if it came from one, their sales request.
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId       String?
  salesRequest   SalesRequest? @relation(fields: [salesRequestId], references: [id], onDelete: SetNull)
  salesRequestId String?

  /// The signed PDF, as a Google Drive link for now (doc §7.1).
  documentUrl String?
  signedOn    DateTime? @db.Date
  /// What the whole contract is worth; every payment's share is of this.
  /// Minor units, with an explicit currency (§4.5).
  totalCents Int?
  currency   String?
  notes      String?
  /// Said on purpose when the contract has no cancellation deadlines at all,
  /// so it stops being flagged as missing them.
  noCancellationTerms Boolean @default(false)

  owner   User?   @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  payments          ContractPayment[]
  cancellations     ContractCancellation[]
  /// The quotation it was made from, if any (doc §3.10).
  quotations        Quotation[]
  acquisitionNights RoomNight[]            @relation("AcquisitionContract")
  salesNights       RoomNight[]            @relation("SalesContract")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([propertyId])
  @@index([clientId])
}

/// One payment a contract schedules — a share of its total, or a set amount.
model ContractPayment {
  id          String   @id @default(cuid())
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId  String
  /// "1st deposit", "Final payment + tax".
  description String
  dueOn       DateTime @db.Date
  /// A share of the contract's total, in hundredths of a percent: 20% is 2000.
  percentBasisPoints Int?
  /// A set amount instead, where the payment is not a plain share of the total.
  amountCents Int?
  status      PaymentStatus @default(TO_BE_PAID)
  paidOn      DateTime?     @db.Date
  invoiceUrl  String?
  proofUrl    String?
  beneficiary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([dueOn])
}

/// One cancellation deadline in a contract: by its cut-off, something may be given back.
model ContractCancellation {
  id         String           @id @default(cuid())
  contract   Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String
  kind       CancellationKind
  cutoffOn   DateTime         @db.Date
  /// How much may go, as a share: 10% is 1000.
  percentBasisPoints Int?
  /// Or in words: "63 room-nights", "2 family rooms".
  appliesTo  String?
  roomType   String?
  /// What cancelling costs, as a share — "with a 30% cancellation fee".
  feeBasisPoints Int?
  remarks    String?
  /// When someone dealt with it. A cut-off is a reminder; nothing happens on its own (§2.4).
  handledOn  DateTime?        @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([cutoffOn])
}

// ---------------------------------------------------------------------------
// NextAuth
// ---------------------------------------------------------------------------

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  scoutedProperties Property[]
  quotationsAdded   Quotation[] @relation("QuotationAddedBy")
  scoutingEntries   ScoutingEntry[] @relation("AddedBy")

  acquisitionNights RoomNight[]        @relation("AcquisitionOwner")
  salesNights       RoomNight[]        @relation("SalesOwner")
  requests          RoomNightRequest[] @relation("RequestOwner")
  ledgerEntries     LedgerEntry[]
  updates           Update[]
  auditEntries      AuditEntry[]

  // The team profile (doc §2.7). The sign-in email above is the contact
  // email: it is what Google vouches for, so it is shown, never edited.
  jobTitle      String?
  phones        UserPhone[]
  // Presence (doc §2.7). When the person last used the system — "Active" or
  // "Away" is judged from this on read, never stored — and the status they
  // set by hand, if any; empty means automatic. A status whose `statusUntil`
  // has passed is ignored on read rather than cleared: nothing changes on its
  // own.
  lastSeenAt    DateTime?
  status        UserStatus?
  statusUntil   DateTime?
  // A status in the person's own words, shown beside their name, with an
  // emoji and an optional time after which it no longer shows.
  customStatusEmoji String?
  customStatusText  String?
  customStatusUntil DateTime?
  conversations ConversationMember[]
  messages      Message[]
  reactions     MessageReaction[]
  customEmoji   CustomEmoji[]
  accountManaged ScoutingEntry[] @relation("AccountManager")
  clientsManaged  Client[]        @relation("ClientAccountManager")
  contractsManaged Contract[]     @relation("ContractOwner")
  salesRequests   SalesRequest[]  @relation("SalesRequestOwner")
  contactsManaged ClientContact[] @relation("ContactAccountManager")
}

// --- The team: profiles and internal chat (doc §2.7) --------------------------

/** How a colleague can be reached on a number — one number is often both. */
enum PhoneKind {
  MOBILE
  WHATSAPP
  MOBILE_AND_WHATSAPP
}

/** A status a person sets by hand, overriding the automatic Active/Away. */
enum UserStatus {
  AWAY
  DO_NOT_DISTURB
}

/** A phone number on a colleague's profile; a person can have any number of them. */
model UserPhone {
  id       String    @id @default(cuid())
  number   String
  kind     PhoneKind
  // The order the person listed them in; the first is the one to try first.
  position Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

/**
 * A chat: either a private conversation between exactly two colleagues, or a
 * named group. `directKey` is the two members' ids, sorted and joined, so that
 * a pair of colleagues can only ever have one private conversation.
 */
model Conversation {
  id        String   @id @default(cuid())
  // Set for a group, empty for a private conversation.
  name      String?
  directKey String?  @unique
  createdAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
}

/** Who is in a conversation, and how far they have read. */
model ConversationMember {
  joinedAt   DateTime  @default(now())
  // Everything posted after this, by someone else, is unread for this member.
  lastReadAt DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([conversationId, userId])
  @@index([userId])
}

/**
 * One chat message: text, a GIF, or both. Its author can edit the text — the
 * earlier wording is kept in `MessageRevision` — but nobody can delete it.
 */
model Message {
  id        String   @id @default(cuid())
  /// Empty for a message that is only a GIF.
  body      String
  createdAt DateTime @default(now())
  // Set when the author last changed the text (doc §2.7).
  editedAt  DateTime?
  revisions MessageRevision[]

  /// The message this one quotes and answers (doc §2.7), in the same conversation.
  replyTo   Message?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replyToId String?
  replies   Message[] @relation("Replies")

  /// A GIF from GIPHY, shown from GIPHY's own address — nothing is stored but the link.
  gifUrl    String?
  gifWidth  Int?
  gifHeight Int?
  gifTitle  String?

  reactions MessageReaction[]

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  @@index([conversationId, createdAt])
}

/**
 * One colleague's reaction to a message (doc §2.7): an emoji, or one of the
 * team's own. Reacting with the same one again takes it back.
 */
model MessageReaction {
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// The emoji itself ("👍"), or "custom:<id>" for one of the team's own.
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
  @@index([userId])
}

/**
 * An emoji the team made (doc §2.7): a name and a small picture, kept in the
 * database itself — it is a few kilobytes, so no file storage is needed.
 */
model CustomEmoji {
  id        String   @id @default(cuid())
  /// Lower case, no spaces: "welodge", "la28".
  name      String   @unique
  /// A small square PNG, as a data address.
  image     String
  createdAt DateTime @default(now())

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

/** A wording a chat message had before its author edited it — kept, never shown yet. */
model MessageRevision {
  id         String   @id @default(cuid())
  body       String
  // When this wording was replaced.
  replacedAt DateTime @default(now())

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String

  @@index([messageId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Phase 2 — Acquisition & Sales (doc §4)
//
// The atomic record is a room-night: one room slot on one calendar date. Every
// room-night carries two independent states — one describing our relationship
// with the supplier, one describing our relationship with the client (doc §2.2).
// ---------------------------------------------------------------------------

/// Our relationship with the *supplier* on one room-night (doc §4.1).
enum AcquisitionState {
  /// Known inventory, no supplier relationship on this night.
  NONE
  /// Actively negotiating — yet to be acquired.
  IN_PROGRESS
  /// We hold the right to purchase until `optionExpiry`.
  OPTION
  /// Acquired under an agreement — this is We Lodge stock.
  BOUGHT
  /// Previously bought, handed back. Kept for audit; counts as not held.
  RELEASED
}

/// Our relationship with the *client* on one room-night (doc §4.2).
///
/// Only `NONE`, `BLOCKED`, `SOLD` and `CANCELLED` are ever stored on a
/// room-night: those are the *hard hold*, and a night has at most one
/// (invariant §4.5.1). `REQUESTED` is never written here — a request is a soft,
/// non-exclusive claim and lives in `RoomNightRequest`, of which a night may
/// have many. `REQUESTED` appears in this enum because it is a value the
/// *displayed* sales state can take (doc §4.3).
enum SalesState {
  NONE
  REQUESTED
  BLOCKED
  SOLD
  CANCELLED
}

/// Which side of the business a ledger entry describes (doc §4.7).
enum LedgerAxis {
  /// Room-nights were brought into existence (doc §3.6).
  INVENTORY
  /// The supplier side.
  ACQUISITION
  /// The client side — a hard hold.
  SALES
  /// The client side — a soft request.
  REQUEST
}

/// A B2B buyer: a federation, broadcaster, sponsor or event team. Clients are
/// global, not per-event — the same federation comes back for the next Games.
/// What kind of organisation a client is (doc §4.10).
enum ClientCategory {
  BROADCASTER
  FEDERATION
  SPONSOR
  EVENT_ORGANISER
  AGENCY
  CORPORATE
  OTHER
}

/// Where a person at a client stands with us (doc §4.10).
enum ContactType {
  LEAD
  QUALIFIED_LEAD
  CUSTOMER
  PARTNER
  OTHER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

/// A company we sell to, or hope to — a lead is a client that has not bought
/// yet, not a separate kind of record (doc §4.10).
model Client {
  id        String  @id @default(cuid())
  name      String
  /// Short form used on the stock sheet where space is tight ("CNOSF").
  shortName String?
  notes     String?

  category ClientCategory?
  /// The colleague who looks after this client.
  accountManager   User?   @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  accountManagerId String?
  /// The company's general line, inbox and website — a person's own are on
  /// their contact.
  phone   String?
  email   String?
  website String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomNights RoomNight[]
  requests   RoomNightRequest[]
  updates    Update[]
  contacts   ClientContact[]
  salesRequests SalesRequest[]
  contracts  Contract[]

  @@unique([name])
}

/// A person at a client (doc §4.10). Their email address is what links
/// emails to them once Gmail is connected, so it is kept as typed, trimmed.
model ClientContact {
  id       String       @id @default(cuid())
  name     String
  title    String?
  email    String?
  mobile   String?
  phone    String?
  type     ContactType?
  priority Priority?
  comments String?

  accountManager   User?   @relation("ContactAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  accountManagerId String?

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  salesRequests SalesRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([email])
}

/// Where a sales request stands (doc §4.11). The first four are open, in the
/// order a request moves through them; the rest close it.
enum SalesRequestStage {
  INITIAL_INTEREST
  PROPOSAL_SENT
  BLOCKED
  SIGNED
  RELEASED
  NO_REPLY
  LOST
}

/// A client's interest in accommodation, followed from the first enquiry to
/// its end — signed, released, lost, or never answered (doc §4.11). Monday
/// calls it a deal. It is the commercial conversation, not the rooms: a
/// room-night's own "requested" is a different, per-night thing (§4.2).
model SalesRequest {
  id    String            @id @default(cuid())
  stage SalesRequestStage @default(INITIAL_INTEREST)

  client   Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId String
  /// The person at the client who asked, if known.
  contact   ClientContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?
  /// Empty for a request not tied to one of our events.
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?
  owner   User?   @relation("SalesRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  // The initial interest, as the client put it — free text, because requests
  // arrive in every shape (doc §4.11).
  description     String?
  location        String?
  rooms           String?
  period          String?
  budget          String?
  prePost         String?
  rateIncludes    String?
  extraServices   String?

  /// Who to chase, and when (doc §4.11).
  followUpOn      DateTime? @db.Date
  nextStep        String?

  proposalSentOn  DateTime? @db.Date
  blockedUntil    DateTime? @db.Date
  /// Minor units, with an explicit currency (§4.5).
  valueCents      Int?
  valueCurrency   String?
  /// When it closed — set on moving to a closing stage, cleared on reopening.
  closedOn        DateTime? @db.Date

  // Contracting details, for the lawyers (doc §4.11). Filled in by us today;
  // by the client through a link later.
  tradeName              String?
  companyAddress         String?
  vatNumber              String?
  registrationNumber     String?
  signatory1Name         String?
  signatory1Designation  String?
  signatory2Name         String?
  signatory2Designation  String?
  /// The people to deal with on the contract: name, job title, email, one per line.
  contractContacts       String?
  propertyNameAndAddress String?
  paymentSchedule        String?
  cancellationPolicy     String?
  otherServices          String?

  /// The private link a client opens to fill in their own contracting
  /// details (doc §4.11): the unguessable part of its address. Empty means no
  /// link, or one switched off; a new link gets a new code, so an old one
  /// stops working.
  contractingToken       String?   @unique
  contractingLinkMadeAt  DateTime?
  /// When the client last sent the form.
  contractingSubmittedAt DateTime?

  /// The room-nights held for this request, and the nights it has asked about.
  nights        RoomNight[]
  nightRequests RoomNightRequest[]
  contracts     Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([eventId])
  @@index([stage])
  @@index([followUpOn])
}

/// A free-text post on a property or a client's history — a meeting note, a
/// call summary, feedback — kept forever like `LedgerEntry`. Exactly one of
/// `propertyId`/`clientId` is set, enforced by the router rather than the
/// database. `@[Full Name]` inside `body` is a mention, written as literal
/// text at post time: mentions are a visual highlight only today, with no
/// notification behind them, so there is nothing to join a `User` row for.
model Update {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  // Set when the author last changed the text (doc §2.6). Every earlier
  // wording is kept in `UpdateRevision`, so an edit never loses what was said.
  editedAt  DateTime?
  revisions UpdateRevision[]

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String?

  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String?

  @@index([propertyId])
  @@index([clientId])
}

/// Our own numbering of a countable room: `property + category + slot number`
/// (doc §2.1). It is *not* the hotel's room number — that is learned at
/// allocation time in Phase 3. A slot is a stable identity across events; the
/// room-nights hanging off it each belong to exactly one event.
/** A wording an update had before its author edited it — kept, never shown yet. */
model UpdateRevision {
  id         String   @id @default(cuid())
  body       String
  // When this wording was replaced.
  replacedAt DateTime @default(now())

  update   Update @relation(fields: [updateId], references: [id], onDelete: Cascade)
  updateId String

  @@index([updateId])
}

model RoomSlot {
  id         String @id @default(cuid())
  slotNumber Int

  category   RoomCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  roomNights RoomNight[]

  @@unique([categoryId, slotNumber])
  @@index([categoryId])
}

/// One room slot on one calendar date — the unit of record for the whole
/// system. The `(slot, date)` uniqueness constraint is invariant §4.5.2, and it
/// is what makes the legacy overlap check unnecessary (doc §11.2).
model RoomNight {
  id String @id @default(cuid())

  /// The night is identified by the date it *begins*. Check-out day is never a
  /// night (doc §2.1).
  date DateTime @db.Date

  slot   RoomSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  slotId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  // --- Acquisition axis: the supplier (doc §4.1) ---------------------------

  acquisitionState AcquisitionState @default(NONE)
  /// The supplier's own reference for this booking — their contract or PO.
  supplierRef      String?
  /// Mandatory while the state is OPTION (invariant §4.5.4).
  optionExpiry     DateTime?        @db.Date
  buyPriceCents    Int?
  buyCurrency      String?
  acquisitionNotes String?

  /// The rep accountable for chasing the supplier (doc §4.7).
  acquisitionOwner   User?   @relation("AcquisitionOwner", fields: [acquisitionOwnerId], references: [id], onDelete: SetNull)
  acquisitionOwnerId String?

  // --- Sales axis: the client's hard hold (doc §4.2, §4.3) -----------------

  /// Never `REQUESTED` — see the note on SalesState.
  salesState     SalesState @default(NONE)
  client         Client?    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId       String?
  /// The client's own reference for this booking.
  clientRef      String?
  /// Mandatory while the state is BLOCKED (invariant §4.5.4).
  blockExpiry    DateTime?  @db.Date
  /// Payment or decision deadline (doc §9, question 2, is still open on which).
  dueDate        DateTime?  @db.Date
  sellPriceCents Int?
  sellCurrency   String?
  salesNotes     String?

  /// The rep accountable for the client (doc §4.7).
  salesOwner   User?   @relation("SalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  salesOwnerId String?

  /// The sales request this hold belongs to (doc §4.11) — always one of the
  /// holding client's own. Cleared when the hold is released; kept on a
  /// cancelled sale, as the client is.
  salesRequest   SalesRequest? @relation(fields: [salesRequestId], references: [id], onDelete: SetNull)
  salesRequestId String?

  /// The signed contracts these nights were bought and sold under (doc §7.1):
  /// one with the supplier, one with the client.
  acquisitionContract   Contract? @relation("AcquisitionContract", fields: [acquisitionContractId], references: [id], onDelete: SetNull)
  acquisitionContractId String?
  salesContract         Contract? @relation("SalesContract", fields: [salesContractId], references: [id], onDelete: SetNull)
  salesContractId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests RoomNightRequest[]
  ledger   LedgerEntry[]      @relation("LedgerNights")

  @@unique([slotId, date])
  @@index([eventId, date])
  @@index([eventId, acquisitionState])
  @@index([eventId, salesState])
  @@index([eventId, optionExpiry])
  @@index([eventId, blockExpiry])
  @@index([clientId])
  @@index([salesRequestId])
}

/// A soft, non-exclusive claim by one client on one room-night (doc §4.3).
/// Many clients may request the same night; that contention is the number that
/// drives the acquisition push. A request never locks the slot.
model RoomNightRequest {
  id String @id @default(cuid())

  roomNight   RoomNight @relation(fields: [roomNightId], references: [id], onDelete: Cascade)
  roomNightId String

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  clientRef      String?
  sellPriceCents Int?
  sellCurrency   String?
  notes          String?

  owner   User?   @relation("RequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  /// The sales request this claim belongs to (doc §4.11), one of the client's own.
  salesRequest   SalesRequest? @relation(fields: [salesRequestId], references: [id], onDelete: SetNull)
  salesRequestId String?

  createdAt DateTime @default(now())

  /// One request per client per night — asking twice is the same claim.
  @@unique([roomNightId, clientId])
  @@index([clientId])
  @@index([salesRequestId])
}

/// An immutable record of one change, written by every mutation that touches a
/// room-night (invariant §4.5.8). One entry per bulk operation, linked to every
/// night it touched, so "who promised this night, and when" is answerable from
/// either end.
model LedgerEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  axis LedgerAxis

  /// The distinct states these nights were in beforehand, joined for reading
  /// ("NONE, IN_PROGRESS"). A bulk operation rarely starts from one state.
  fromState String?
  /// The state applied. Null where the change was to attributes only — a
  /// re-price, a deadline extension, an owner reassignment.
  toState   String?

  /// A sentence a non-technical reader can follow, written at write time.
  summary    String
  /// Why, in the actor's words. Optional but asked for on every action.
  reason     String?
  /// What the change did to the nights' details, one line per field and
  /// value — "Sell price: US$ 450.00 → US$ 480.00 (21 room-nights)" — so an
  /// overwrite says exactly what it overwrote (doc §4.7). Empty on entries
  /// written before this was recorded.
  details    String?
  nightCount Int

  /// Every affected night's mutable fields, exactly as they were *before*
  /// this entry's write — dates as ISO strings, one object per night, each
  /// carrying `nightId` and `existed` (false for a night this entry brought
  /// into being, meaning undo deletes it rather than restoring fields).
  /// What makes undo possible: unlike `fromState`/`toState`, which are only
  /// ever a state's label, this is the actual data.
  beforeSnapshot Json?
  /// False only on the entry an undo itself writes, so undo can never chain
  /// into undoing an undo.
  undoable       Boolean @default(true)
  /// When this entry was undone, if it has been. An undone entry no longer
  /// stands in the way of undoing what came before it, and cannot be undone
  /// twice (doc §4.7).
  undoneAt       DateTime?
  /// True on the entry an undo writes — a record of the undo, which is never
  /// itself something that blocks undoing an earlier entry.
  isUndo         Boolean @default(false)

  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  nights RoomNight[] @relation("LedgerNights")

  @@index([eventId, createdAt])
}

/// A general, append-only record of a change to something other than a
/// room-night — a status flip, a property/client/event edit (doc §4.9).
/// `entityId` is a plain string, not a relation: history is meant to outlive
/// the row it describes, so deleting a property or a scouting entry must
/// never take its audit trail down with it.
model AuditEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  /// "Property" | "Client" | "Event" | "ScoutingEntry" | "CategoryContract"
  entity   String
  entityId String

  /// A sentence a non-technical reader can follow, written at write time.
  summary String
  /// One line per changed field ("Name: \"Old\" → \"New\""). Free text —
  /// nothing here is machine-read back; that is what LedgerEntry.beforeSnapshot
  /// is for.
  changes String?

  @@index([entity, entityId, createdAt])
}
